# Development only: the app keeps the key in the macOS Keychain. Nebius Token Factory (OpenAI-compatible API);
# turn on Zero Data Retention for the organization.
NEBIUS_API_KEY=
# Optional. Default: https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL=
# Optional. Swap a profile's model (defaults in packages/llm/src/catalog.ts; check a swap with `pnpm llm:check`).
# TASKPLAYER_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
# TASKPLAYER_MODEL_SMART=nvidia/nemotron-3-super-120b-a12b
# TASKPLAYER_MODEL_VISION=zai-org/GLM-5.3-Flash

# Optional. LLM steps are capped per run: model calls, and characters of data sent per call.
TASKPLAYER_AI_MAX_CALLS_PER_RUN=3
TASKPLAYER_AI_MAX_INPUT_CHARS=20000
# Optional. Folders whose file moves and renames are recorded. Default: your whole home folder (minus ~/Library but
# with your cloud drives in it, hidden folders and node_modules); a folder outside it (an external drive) is added
# when a Finder window shows it.
# Set it only to narrow that down (":"-separated, e.g. ~/Work:~/Downloads). Set to nothing, it turns file capture off.
# TASKPLAYER_WATCH_DIRS=
