# Nemotron on our own Nebius Serverless endpoint (OpenAI-compatible API)
NEBIUS_BASE_URL=https://your-endpoint.example/v1
NEBIUS_API_KEY=
NEMOTRON_MODEL=

# Optional. Per-run AI steps (data.ai) are capped: model calls per run, and characters of data sent per call.
TASKPLAYER_AI_MAX_CALLS_PER_RUN=3
TASKPLAYER_AI_MAX_INPUT_CHARS=20000
# Optional. US dollars per million input tokens, only to show what a per-run AI step costs before you keep it.
NEMOTRON_PRICE_PER_MTOK=
# Optional. Folders whose file changes are recorded (":"-separated; empty turns it off). Default ~/Downloads:~/Desktop
TASKPLAYER_WATCH_DIRS=
