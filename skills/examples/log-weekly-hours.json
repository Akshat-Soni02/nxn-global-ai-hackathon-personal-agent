{
  "id": "log-weekly-hours",
  "version": 1,
  "intent": "Fill in this week's hours on the timesheet site and save a draft",
  "inputs": {
    "hours": { "type": "number", "description": "Hours worked this week" },
    "project": { "type": "string", "description": "Project code" }
  },
  "triggers": [{ "type": "schedule", "cron": "0 17 * * 5" }],
  "steps": [
    {
      "id": "s1",
      "intent": "Open the timesheet page",
      "channel": "web",
      "action": "navigate",
      "args": { "url": "http://localhost:5173/timesheet.html" }
    },
    {
      "id": "s2",
      "intent": "Choose the project",
      "channel": "web",
      "action": "select",
      "target": { "role": "combobox", "label": "Project" },
      "args": { "value": "{{inputs.project}}" }
    },
    {
      "id": "s3",
      "intent": "Enter the hours",
      "channel": "web",
      "action": "type",
      "target": { "role": "textbox", "label": "Hours" },
      "args": { "text": "{{inputs.hours}}" }
    },
    {
      "id": "s4",
      "intent": "Save as draft",
      "channel": "web",
      "action": "click",
      "target": { "role": "button", "name": "Save draft" },
      "check": { "text_visible": "Draft saved" },
      "on_fail": { "retries": 1, "fallback": "agent" }
    }
  ]
}
