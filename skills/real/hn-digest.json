{
  "id": "hn-digest",
  "name": "Hacker News digest",
  "version": 1,
  "description": {
    "goal": "Today's top 5 Hacker News stories are saved as a Markdown digest and open in TextEdit",
    "changes": ["the stories", "the date"],
    "constants": ["news.ycombinator.com", "top 5", "~/TaskPlayerTest/digests"],
    "never": []
  },
  "triggers": [
    {
      "type": "manual"
    },
    {
      "type": "schedule",
      "cron": "30 8 * * *"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "type": "action",
      "intent": "Open the Hacker News front page",
      "channel": "web",
      "action": "navigate",
      "args": {
        "url": "https://news.ycombinator.com/"
      },
      "check": {
        "text_visible": "Hacker News"
      }
    },
    {
      "id": "s2",
      "type": "action",
      "intent": "Collect the first 5 story titles with their links",
      "channel": "web",
      "action": "extract",
      "target": {
        "role": "link",
        "near": "story title",
        "fallbacks": ["tr.athing span.titleline > a"]
      },
      "args": {
        "all": true,
        "limit": 5,
        "each": "- [{{text}}]({{href}})",
        "join": "\n"
      },
      "save_as": "stories"
    },
    {
      "id": "s3",
      "type": "action",
      "intent": "Write the digest file",
      "channel": "fs",
      "action": "write",
      "args": {
        "path": "~/TaskPlayerTest/digests/hn-{{today}}.md",
        "content": "# Hacker News top 5, {{today}}\n\n{{vars.stories}}\n"
      },
      "check": {
        "file_exists": "~/TaskPlayerTest/digests/hn-{{today}}.md"
      }
    },
    {
      "id": "s4",
      "type": "action",
      "intent": "Open the digest in TextEdit",
      "channel": "script",
      "action": "applescript",
      "args": {
        "source": "set f to (POSIX path of (path to home folder)) & \"TaskPlayerTest/digests/hn-{{today}}.md\"\ntell application \"TextEdit\"\n  open (POSIX file f)\n  activate\nend tell"
      }
    }
  ],
  "success": [
    {
      "file_exists": "~/TaskPlayerTest/digests/hn-{{today}}.md"
    }
  ],
  "history": [
    {
      "version": 1,
      "by": "user",
      "summary": "Hand-written test skill",
      "at": "2026-10-02T10:00:00Z"
    }
  ]
}
