{
  "id": "upload-test-file",
  "name": "Upload test file",
  "version": 1,
  "description": {
    "goal": "The newest sandbox test file is uploaded to the-internet's uploader and filed under done/",
    "changes": ["the file to upload"],
    "constants": ["the-internet.herokuapp.com/upload", "the ~/TaskPlayerTest/upload folder", "the done/ folder"],
    "never": ["upload anything outside ~/TaskPlayerTest"]
  },
  "steps": [
    {
      "id": "start",
      "type": "trigger",
      "intent": "By hand, or when a new .txt lands in the sandbox upload folder",
      "when": [
        {
          "type": "manual"
        },
        {
          "type": "folder_watch",
          "dir": "~/TaskPlayerTest/upload",
          "glob": "*.txt"
        }
      ],
      "inputs": {
        "file": {
          "type": {
            "type": "file"
          },
          "description": "Newest .txt in the sandbox upload folder. The site is public: never point this at real documents.",
          "resolve": {
            "dir": "~/TaskPlayerTest/upload",
            "glob": "*.txt",
            "pick": "newest"
          },
          "example": "~/TaskPlayerTest/upload/taskplayer-test-2026-10-02T09-52-44-024Z.txt"
        }
      }
    },
    {
      "id": "s1",
      "type": "action",
      "intent": "Open the file uploader page (the site sometimes stalls on a script, so retry once)",
      "channel": "web",
      "action": "navigate",
      "args": {
        "url": "https://the-internet.herokuapp.com/upload"
      },
      "check": {
        "text_visible": "File Uploader"
      },
      "on_fail": {
        "retries": 1,
        "fallback": "ask"
      }
    },
    {
      "id": "s2",
      "type": "action",
      "intent": "Attach the test file to the file input",
      "channel": "web",
      "action": "upload",
      "target": {
        "near": "File Uploader",
        "attrs": {
          "type": "file",
          "id": "file-upload",
          "name": "file"
        },
        "fallbacks": ["#file-upload", "input[type=file][name=file]"]
      },
      "args": {
        "file": "{{file}}"
      }
    },
    {
      "id": "s3",
      "type": "action",
      "intent": "Submit the upload",
      "channel": "web",
      "action": "click",
      "target": {
        "role": "button",
        "name": "Upload",
        "near": "File Uploader",
        "attrs": {
          "id": "file-submit"
        },
        "fallbacks": ["#file-submit", "input[type=submit][value=Upload]"]
      },
      "requires_approval": true,
      "check": {
        "text_visible": "File Uploaded!"
      },
      "on_fail": {
        "retries": 1,
        "fallback": "agent"
      }
    },
    {
      "id": "s4",
      "type": "action",
      "intent": "Confirm the uploaded file's name is listed",
      "channel": "web",
      "action": "wait_for",
      "target": {
        "attrs": {
          "id": "uploaded-files"
        },
        "fallbacks": ["#uploaded-files"]
      },
      "check": {
        "text_visible": "{{file.name}}"
      }
    },
    {
      "id": "s5",
      "type": "action",
      "intent": "Move the uploaded file into done/ so it is not uploaded again",
      "channel": "fs",
      "action": "move",
      "args": {
        "from": "{{file}}",
        "to": "~/TaskPlayerTest/upload/done/"
      },
      "check": {
        "file_exists": "~/TaskPlayerTest/upload/done/{{file.name}}"
      }
    }
  ],
  "success": [
    {
      "file_exists": "~/TaskPlayerTest/upload/done/{{file.name}}"
    }
  ],
  "history": [
    {
      "version": 1,
      "by": "user",
      "summary": "Hand-written test skill",
      "at": "2026-10-02T10:00:00Z"
    }
  ]
}
