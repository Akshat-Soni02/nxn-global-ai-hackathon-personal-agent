{
  "id": "sort-inbox",
  "name": "Sort the inbox",
  "version": 1,
  "description": {
    "goal": "The sandbox inbox is sorted into PDFs, images and notes folders",
    "changes": ["the files in the inbox"],
    "constants": ["~/TaskPlayerTest/inbox", "the sorted/ folders"],
    "never": ["delete files"]
  },
  "steps": [
    {
      "id": "start",
      "type": "trigger",
      "intent": "By hand, or when the sandbox inbox changes",
      "when": [
        {
          "type": "manual"
        },
        {
          "type": "folder_watch",
          "dir": "~/TaskPlayerTest/inbox"
        }
      ]
    },
    {
      "id": "s1",
      "type": "action",
      "intent": "Find PDFs in the inbox",
      "channel": "fs",
      "action": "find",
      "args": {
        "dir": "~/TaskPlayerTest/inbox",
        "glob": "*.pdf",
        "pick": "all"
      },
      "output": {
        "name": "pdfs",
        "type": {
          "type": "list",
          "items": {
            "type": "file"
          }
        }
      }
    },
    {
      "id": "s2",
      "type": "action",
      "intent": "Move PDFs to sorted/pdfs",
      "channel": "fs",
      "action": "move",
      "args": {
        "from": "{{pdfs}}",
        "to": "~/TaskPlayerTest/sorted/pdfs/"
      }
    },
    {
      "id": "s3",
      "type": "action",
      "intent": "Find images in the inbox",
      "channel": "fs",
      "action": "find",
      "args": {
        "dir": "~/TaskPlayerTest/inbox",
        "glob": "*.{png,jpg,jpeg,heic}",
        "pick": "all"
      },
      "output": {
        "name": "images",
        "type": {
          "type": "list",
          "items": {
            "type": "file"
          }
        }
      }
    },
    {
      "id": "s4",
      "type": "action",
      "intent": "Move images to sorted/images",
      "channel": "fs",
      "action": "move",
      "args": {
        "from": "{{images}}",
        "to": "~/TaskPlayerTest/sorted/images/"
      }
    },
    {
      "id": "s5",
      "type": "action",
      "intent": "Find text notes in the inbox",
      "channel": "fs",
      "action": "find",
      "args": {
        "dir": "~/TaskPlayerTest/inbox",
        "glob": "*.{txt,md}",
        "pick": "all"
      },
      "output": {
        "name": "notes",
        "type": {
          "type": "list",
          "items": {
            "type": "file"
          }
        }
      }
    },
    {
      "id": "s6",
      "type": "action",
      "intent": "Move notes to sorted/notes",
      "channel": "fs",
      "action": "move",
      "args": {
        "from": "{{notes}}",
        "to": "~/TaskPlayerTest/sorted/notes/"
      }
    },
    {
      "id": "s7",
      "type": "action",
      "intent": "Tell the user the inbox was sorted",
      "channel": "script",
      "action": "applescript",
      "args": {
        "source": "display notification \"Inbox sorted\" with title \"Task Player\""
      }
    }
  ],
  "history": [
    {
      "version": 1,
      "by": "user",
      "summary": "Hand-written test skill",
      "at": "2026-10-02T10:00:00Z"
    }
  ]
}
