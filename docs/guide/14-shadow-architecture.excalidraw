      "updated": 1,
      "link": null,
      "locked": false,
      "text": "{ \"id\": \"vendor-invoices-k3f9q2\", \"name\": \"Vendor invoices → Xero\", \"version\": 2,\n  \"description\": { \"goal\": \"unread invoices are billed in Xero\",\n                   \"changes\": [\"the invoices\"], \"constants\": [\"Xero org\"], \"never\": [\"pay\"] },\n  \"steps\": [\n    { \"id\": \"t\", \"type\": \"trigger\", \"when\": { \"type\": \"manual\" }, \"inputs\": {} },\n    { \"id\": \"s1\", \"type\": \"action\", \"channel\": \"web\", \"action\": \"extract\",\n      \"target\": { \"role\": \"link\", \"name\": \"Invoices\" }, \"args\": { \"all\": true },\n      \"output\": { \"name\": \"emails\", \"type\": { \"type\": \"list\", \"items\": { \"type\": \"text\" } } } },\n    { \"id\": \"l1\", \"type\": \"control\", \"kind\": \"loop\", \"over\": \"{{emails}}\", \"item\": \"email\",\n      \"max_items\": 100, \"on_item_fail\": \"skip\", \"steps\": [\n        { \"id\": \"s2\", \"type\": \"llm\", \"instruction\": \"Read vendor, number and amount\",\n          \"inputs\": [\"{{email}}\"], \"output\": { \"name\": \"invoice\", \"type\": { \"type\": \"object\" } } },\n        { \"id\": \"b1\", \"type\": \"control\", \"kind\": \"branch\",\n          \"if\": { \"left\": \"{{invoice.amount}}\", \"op\": \"greater_than\", \"right\": 5000 },\n          \"steps\": [ { \"id\": \"s3\", ..., \"ask\": { \"question\": \"Large invoice. Continue?\",\n                                                  \"kind\": \"confirm\" } } ] },\n        { \"id\": \"s5\", \"type\": \"action\", \"channel\": \"web\", \"action\": \"click\",\n          \"target\": { \"role\": \"button\", \"name\": \"Create bill\" }, \"requires_approval\": true } ] } ],\n  \"history\": [ { \"version\": 2, \"by\": \"debug\", \"summary\": \"Create bill moved into the ⋯ menu\",\n                 \"at\": \"2026-10-12T09:14:00Z\" } ] }",
      "originalText": "{ \"id\": \"vendor-invoices-k3f9q2\", \"name\": \"Vendor invoices → Xero\", \"version\": 2,\n  \"description\": { \"goal\": \"unread invoices are billed in Xero\",\n                   \"changes\": [\"the invoices\"], \"constants\": [\"Xero org\"], \"never\": [\"pay\"] },\n  \"steps\": [\n    { \"id\": \"t\", \"type\": \"trigger\", \"when\": { \"type\": \"manual\" }, \"inputs\": {} },\n    { \"id\": \"s1\", \"type\": \"action\", \"channel\": \"web\", \"action\": \"extract\",\n      \"target\": { \"role\": \"link\", \"name\": \"Invoices\" }, \"args\": { \"all\": true },\n      \"output\": { \"name\": \"emails\", \"type\": { \"type\": \"list\", \"items\": { \"type\": \"text\" } } } },\n    { \"id\": \"l1\", \"type\": \"control\", \"kind\": \"loop\", \"over\": \"{{emails}}\", \"item\": \"email\",\n      \"max_items\": 100, \"on_item_fail\": \"skip\", \"steps\": [\n        { \"id\": \"s2\", \"type\": \"llm\", \"instruction\": \"Read vendor, number and amount\",\n          \"inputs\": [\"{{email}}\"], \"output\": { \"name\": \"invoice\", \"type\": { \"type\": \"object\" } } },\n        { \"id\": \"b1\", \"type\": \"control\", \"kind\": \"branch\",\n          \"if\": { \"left\": \"{{invoice.amount}}\", \"op\": \"greater_than\", \"right\": 5000 },\n          \"steps\": [ { \"id\": \"s3\", ..., \"ask\": { \"question\": \"Large invoice. Continue?\",\n                                                  \"kind\": \"confirm\" } } ] },\n        { \"id\": \"s5\", \"type\": \"action\", \"channel\": \"web\", \"action\": \"click\",\n          \"target\": { \"role\": \"button\", \"name\": \"Create bill\" }, \"requires_approval\": true } ] } ],\n  \"history\": [ { \"version\": 2, \"by\": \"debug\", \"summary\": \"Create bill moved into the ⋯ menu\",\n                 \"at\": \"2026-10-12T09:14:00Z\" } ] }",
