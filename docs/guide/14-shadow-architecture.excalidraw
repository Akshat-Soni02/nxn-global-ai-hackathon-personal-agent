      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "~/Library/Application Support/Shadow/\n skills/<id>/v1.json     by: record\n skills/<id>/v2.json     by: debug\n skills/<id>/state.json  live / paused\n skills/<id>/draft.json  edit ops       (new)\n recordings/<s>/  24 h: form, events, shots\n runs/<runId>.jsonl      every step\n runs/<runId>.repair-1.json  agent log\n shadow.db   runs + inbox tables\n memory.db   drill answers, site notes\n api.json    port + token (0600)\n~/Library/Logs/Shadow/daemon.log",
      "originalText": "~/Library/Application Support/Shadow/\n skills/<id>/v1.json     by: record\n skills/<id>/v2.json     by: debug\n skills/<id>/state.json  live / paused\n skills/<id>/draft.json  edit ops       (new)\n recordings/<s>/  24 h: form, events, shots\n runs/<runId>.jsonl      every step\n runs/<runId>.repair-1.json  agent log\n shadow.db   runs + inbox tables\n memory.db   drill answers, site notes\n api.json    port + token (0600)\n~/Library/Logs/Shadow/daemon.log",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
