   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No NVIDIA model on Token Factory reads images\ntoday (Omni was removed 31 Aug 2026), so a\nvision model turns pixels into text and\nNemotron makes every decision.\n\nThe API key lives in a small proxy, never in\nthe app: users never see tokens or cost.\nCredits: $25 hackathon form + $25 Builders.\nCosts = catalogue price × estimated tokens.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No NVIDIA model on Token Factory reads images\ntoday (Omni was removed 31 Aug 2026), so a\nvision model turns pixels into text and\nNemotron makes every decision.\n\nThe API key lives in a small proxy, never in\nthe app: users never see tokens or cost.\nCredits: $25 hackathon form + $25 Builders.\nCosts = catalogue price × estimated tokens.",
   "autoResize": true,
   "lineHeight": 1.25
  }
