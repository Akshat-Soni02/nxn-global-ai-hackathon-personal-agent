   "link": null,
   "locked": false,
   "text": "{ \"intent\": \"Upload the newest invoice\",\n  \"inputs\": { \"invoice\": \"newest invoice-*.pdf\" },\n  \"steps\": [\n    { \"action\": \"navigate\", \"url\": \".../upload\" },\n    { \"action\": \"upload\",\n      \"target\": { \"role\": \"button\",\n                  \"name\": \"Upload invoice\",\n                  \"near\": \"Documents\" } },\n    { \"action\": \"click\",\n      \"target\": { \"role\": \"button\", \"name\": \"Submit\" },\n      \"requires_approval\": true }\n  ] }",
