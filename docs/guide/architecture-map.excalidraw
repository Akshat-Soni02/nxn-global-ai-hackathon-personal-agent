   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Model                         Size (total / active)   Reads   Used for                                          ~cost per call\nNemotron 3.5 Lightning        30B / 3B                text    goal questions, rescue pick, judge, sheet map     $0.0001–0.0002\nNemotron 3 Super              120B / 12B              text    compile a recording into a skill (thinking on)    ~$0.0075\nNemotron 3 Ultra              550B / 55B              text    long recordings, or compiles that keep failing    ~$0.025\nGLM-5.3-Flash   (not NVIDIA)  320B / 18B              image   step captions, vision pick                        ~$0.0007\nQwen3.8-27B     (not NVIDIA)  27B                     image   backup if GLM's captions fall short               ~$0.002",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Model                         Size (total / active)   Reads   Used for                                          ~cost per call\nNemotron 3.5 Lightning        30B / 3B                text    goal questions, rescue pick, judge, sheet map     $0.0001–0.0002\nNemotron 3 Super              120B / 12B              text    compile a recording into a skill (thinking on)    ~$0.0075\nNemotron 3 Ultra              550B / 55B              text    long recordings, or compiles that keep failing    ~$0.025\nGLM-5.3-Flash   (not NVIDIA)  320B / 18B              image   step captions, vision pick                        ~$0.0007\nQwen3.8-27B     (not NVIDIA)  27B                     image   backup if GLM's captions fall short               ~$0.002",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
