      "y": 1571.75,
      "width": 1092,
      "height": 22,
      "text": "🔒 Your API key and data",
      "originalText": "🔒 Your API key and data",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b91c1c",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t_163",
      "x": 1844,
      "y": 1599,
      "width": 1092,
      "height": 38,
      "text": "Only the daemon uses the key. Only text (and, with your consent, redacted screenshots) goes to Nebius, with Zero Data Retention. Secret\nvalues are never logged or sent.",
      "originalText": "Only the daemon uses the key. Only text (and, with your consent, redacted screenshots) goes to Nebius, with Zero Data Retention. Secret\nvalues are never logged or sent.",
