    {
      "type": "text",
      "id": "t_150",
      "x": 1844,
      "y": 1245,
      "width": 1092,
      "height": 22,
      "text": "🔒 A token on every call",
      "originalText": "🔒 A token on every call",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b91c1c",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t_151",
      "x": 1844,
      "y": 1272.25,
      "width": 1092,
      "height": 38,
      "text": "New at every start, written to api.json that only you can read. The window gets it in the link's #part, which is never sent to a server.\nPages hold no data, so they need no token; every /api call does.",
      "originalText": "New at every start, written to api.json that only you can read. The window gets it in the link's #part, which is never sent to a server.\nPages hold no data, so they need no token; every /api call does.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1f2937",
      "lineHeight": 1.25
    },
    {
      "type": "rectangle",
      "id": "r_152",
      "x": 1830,
      "y": 1328.75,
      "width": 1120,
      "height": 69,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fee2e2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "t_153",
      "x": 1844,
      "y": 1340.75,
      "width": 1092,
      "height": 22,
      "text": "🔒 Other websites in your browser",
      "originalText": "🔒 Other websites in your browser",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b91c1c",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t_154",
      "x": 1844,
      "y": 1368,
      "width": 1092,
      "height": 19,
      "text": "Blocked by the Origin check, and they don't know the token. DNS-rebinding tricks: blocked by the Host check.",
      "originalText": "Blocked by the Origin check, and they don't know the token. DNS-rebinding tricks: blocked by the Host check.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1f2937",
      "lineHeight": 1.25
    },
    {
      "type": "rectangle",
      "id": "r_155",
      "x": 1830,
      "y": 1405.75,
      "width": 1120,
      "height": 69,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fee2e2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
