    {
      "type": "text",
      "id": "t_103",
      "x": 1844,
      "y": 842.75,
      "width": 1092,
      "height": 24,
      "text": "Two doors, one API",
      "originalText": "Two doors, one API",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#6d28d9",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t_104",
      "x": 1844,
      "y": 872.5,
      "width": 1092,
      "height": 38,
      "text": "Unix socket for programs (Shadow.app; the extension via the shim; tools). HTTP for the window, because web pages speak HTTP. Both call\nthe same methods (workflows, runs, inbox, answer, start, cancel, rollback).",
      "originalText": "Unix socket for programs (Shadow.app; the extension via the shim; tools). HTTP for the window, because web pages speak HTTP. Both call\nthe same methods (workflows, runs, inbox, answer, start, cancel, rollback).",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1f2937",
      "lineHeight": 1.25
    },
