      "type": "text",
      "id": "t_107",
      "x": 60,
      "y": 1516,
      "width": 1640,
      "height": 19,
      "text": "The run never waits in memory: it stops, is saved, and goes on when you answer. Even if the daemon restarts in between.",
      "originalText": "The run never waits in memory: it stops, is saved, and goes on when you answer. Even if the daemon restarts in between.",
