      "x": 60,
      "y": 2056,
      "width": 757,
      "height": 35,
      "text": "5 · Before milestone 6, now, and what is still true",
      "originalText": "5 · Before milestone 6, now, and what is still true",
      "fontSize": 28,
      "fontFamily": 3,
