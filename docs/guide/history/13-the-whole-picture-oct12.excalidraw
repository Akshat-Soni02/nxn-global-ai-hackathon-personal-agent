    {
      "type": "text",
      "id": "t_159",
      "x": 1844,
      "y": 1494.75,
      "width": 1092,
      "height": 22,
      "text": "🔒 Only Shadow's extension",
      "originalText": "🔒 Only Shadow's extension",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b91c1c",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t_160",
      "x": 1844,
      "y": 1522,
      "width": 1092,
      "height": 19,
      "text": "Chrome lets only the extension with Shadow's fixed ID use the native host.",
      "originalText": "Chrome lets only the extension with Shadow's fixed ID use the native host.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
