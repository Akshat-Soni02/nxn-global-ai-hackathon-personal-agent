      "id": "t_184",
      "x": 639,
      "y": 2247.75,
      "width": 487,
      "height": 40,
      "text": "• Restart-safe: answer later, the run goes on from where\nit stopped.",
      "originalText": "• Restart-safe: answer later, the run goes on from where\nit stopped.",
