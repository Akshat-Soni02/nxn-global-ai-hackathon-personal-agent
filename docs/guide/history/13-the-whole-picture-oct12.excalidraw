      "id": "t_183",
      "x": 639,
      "y": 2224.75,
      "width": 487,
      "height": 20,
      "text": "• Waiting is saved: inbox item + checkpoint in shadow.db.",
      "originalText": "• Waiting is saved: inbox item + checkpoint in shadow.db.",
