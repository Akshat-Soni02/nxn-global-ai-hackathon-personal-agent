    },
    {
      "type": "rectangle",
      "id": "r_81",
      "x": 1800,
      "y": 110,
      "width": 1180,
      "height": 829,
      "strokeColor": "#9ca3af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
