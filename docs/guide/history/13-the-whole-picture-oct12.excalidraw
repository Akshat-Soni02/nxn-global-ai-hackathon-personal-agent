      "id": "t_182",
      "x": 639,
      "y": 2181.75,
      "width": 487,
      "height": 40,
      "text": "• launchd starts the daemon at login and restarts it\n(pnpm setup:daemon).",
      "originalText": "• launchd starts the daemon at login and restarts it\n(pnpm setup:daemon).",
