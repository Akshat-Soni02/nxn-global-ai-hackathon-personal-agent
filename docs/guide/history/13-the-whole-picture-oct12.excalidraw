    },
    {
      "type": "text",
      "id": "t_101",
      "x": 1844,
      "y": 783,
      "width": 1092,
      "height": 19,
      "text": "Only macOS is there at login and after a crash. A daemon started in a terminal dies when the terminal closes; launchd keeps it running.",
      "originalText": "Only macOS is there at login and after a crash. A daemon started in a terminal dies when the terminal closes; launchd keeps it running.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1f2937",
      "lineHeight": 1.25
    },
    {
      "type": "rectangle",
      "id": "r_102",
