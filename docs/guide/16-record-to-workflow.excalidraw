    {
      "type": "text",
      "id": "b7f_t",
      "x": 3144,
      "y": 1662,
      "text": "7f FINISH GATE (code)\nrefuses \"done\" while:\n· work you showed is gone\n· a rule you said isn't built (\"the newest\" too)\n· a check uses text that never appeared on screen\n· a test failed unexplained, or couldn't start\n· a step can't run (stale check, wrong tab)\n· how often doesn't match, or isn't a fixed time\nAfter 2 refusals it saves with the gaps listed,\nunless your work is lost or a step can't run:\nthen your recorded steps are kept",
      "fontSize": 14,
      "strokeColor": "#374151",
      "textAlign": "left",
      "containerId": "b7f",
      "seed": 800031,
      "originalText": "7f FINISH GATE (code)\nrefuses \"done\" while:\n· work you showed is gone\n· a rule you said isn't built (\"the newest\" too)\n· a check uses text that never appeared on screen\n· a test failed unexplained, or couldn't start\n· a step can't run (stale check, wrong tab)\n· how often doesn't match, or isn't a fixed time\nAfter 2 refusals it saves with the gaps listed,\nunless your work is lost or a step can't run:\nthen your recorded steps are kept",
      "roughness": 0,
      "opacity": 100,
