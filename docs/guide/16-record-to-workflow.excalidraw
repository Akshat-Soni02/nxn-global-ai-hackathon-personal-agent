    {
      "type": "text",
      "id": "br_s",
      "x": 1500,
      "y": 1486,
      "text": "Nemotron 3 Super, in stages run by code (design/v2/orchestrator.ts). One budget for the whole design:\n$0.25 and 40 model calls, captions included. A reply cut off at the token cap gets one more episode.\nIt only ever reads masked text.",
      "fontSize": 15,
      "strokeColor": "#374151",
