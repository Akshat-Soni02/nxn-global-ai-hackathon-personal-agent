    {
      "type": "text",
      "id": "b7c_t",
      "x": 1874,
      "y": 1662,
      "text": "7c SAFE TEST RUN\nin the automation window: opens pages,\nreads, follows recorded links. Never\ntypes, sends or presses acting buttons;\na file this run would download is only\noutlined. At most 3 per design; \"not\nrun\" without Chrome.",
      "fontSize": 14,
      "strokeColor": "#374151",
      "textAlign": "left",
