{
  "name": "taskplayer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "daemon": "pnpm --filter @taskplayer/daemon start",
    "extension": "pnpm --filter @taskplayer/extension dev",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "setup:native-host": "tsx scripts/install-native-host.ts",
    "seed:sandbox": "tsx scripts/seed-sandbox.ts",
    "snapshot:pages": "tsx scripts/snapshot-pages.ts",
    "replay": "tsx scripts/replay.ts",
    "daemon:dev": "pnpm --filter @taskplayer/daemon dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "linkedom": "^0.18.13",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
